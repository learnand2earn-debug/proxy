# AI Proxy Intelligence, Discovery & Monitoring Platform
# Environment Configuration

# Admin Authentication Credentials
ADMIN_USERNAME=websitespark20
ADMIN_PASSWORD=spark78601

# Next.js Port and Base URL
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth and Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage / Database mode: 'hybrid' (uses local mock/sqlite fallback if Supabase unconfigured) or 'supabase'
DB_MODE=hybrid

# Background Worker Settings
WORKER_PORT=3001
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL_MS=15000
WORKER_SECRET_KEY=change-this-worker-secret-in-production

# Security & SSRF Protection
ALLOW_INTERNAL_IPS=false
HEALTHCHECK_TARGET_URL=http://localhost:3000/api/health/diagnostic
MAX_CHECK_TIMEOUT_MS=6000

# Notification Providers
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@proxyintel.ai

# AI Assistant Settings (Optional: Heuristic fallback is included)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Chrome Extension Sync Secret (for initial extension pairing)
CHROME_SYNC_SECRET=dev-chrome-extension-pairing-token-321
